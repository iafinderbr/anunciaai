# Banco PostgreSQL usado pelas APIs de estatísticas e pelas contas.
# Nunca versione credenciais reais neste arquivo.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Autenticação (Better Auth + Google OAuth).
# BETTER_AUTH_SECRET deve ter pelo menos 32 caracteres de alta entropia.
# Em produção, use exatamente a URL pública do AnunciaAI.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://anunciaai.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login social opcional com Facebook.
# O provider só é habilitado quando OS DOIS valores existem no ambiente.
# Nunca use prefixo NEXT_PUBLIC_ nestes segredos.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Stripe Billing / AnunciaAI Pro.
# STRIPE_SECRET_KEY e STRIPE_WEBHOOK_SECRET são SOMENTE de servidor.
# Nunca use NEXT_PUBLIC_ e nunca versione valores reais.
# Em teste, se STRIPE_PRO_PRICE_ID estiver vazio, o código usa o Price ID sandbox conhecido do Pro.
# Em produção/live, STRIPE_PRO_PRICE_ID é obrigatório e deve apontar para o Price live de R$ 19,90/mês.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Opcional: configuração específica do Customer Portal.
STRIPE_PORTAL_CONFIGURATION_ID=

# Backend generativo opcional. Permanece desligado por padrão.
# GEMINI_API_KEY deve existir somente no servidor/Vercel e nunca usar prefixo NEXT_PUBLIC_.
ANUNCIAAI_GENERATIVE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
